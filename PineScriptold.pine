//@version=5
indicator("Price Volume (₹Cr + Raw)", overlay=false)

// === INPUT ===
length = input.int(20, title="Moving Average Length")

// === CALCULATIONS ===
priceVolume = close * volume
priceVolumeCr = priceVolume / 1e7  // ₹ Crore
pv_ma = ta.sma(priceVolume, length)

// === PLOT HISTOGRAM ===
barColor = priceVolume > priceVolume[1] ? color.lime : color.red
plot(priceVolume, title="Price Volume", style=plot.style_columns, color=barColor)
plot(pv_ma, title="SMA (₹ Volume)", color=color.orange, linewidth=2)

// === DATA WINDOW DISPLAY ===
// This will allow you to see ₹ Cr value for any candle when you hover over it
plot(priceVolumeCr, title="Price Volume (₹ Cr)", display=display.data_window, color=color.new(color.green, 100))

// === STATIC TABLE (BOTTOM-LEFT) FOR LATEST BAR ONLY ===
var table infoTable = table.new(position.bottom_left, 2, 2, border_width=1)

latestCr = str.tostring(priceVolumeCr, "#.##") + " Cr"
latestRaw = str.tostring(priceVolume, "#")

table.cell(infoTable, 0, 0, "AbsVol in ₹Cr", text_color=color.white, bgcolor=color.blue)
table.cell(infoTable, 1, 0, latestCr, text_color=color.white, bgcolor=color.blue)
table.cell(infoTable, 0, 1, "Raw ₹ Value", text_color=color.white, bgcolor=color.purple)
table.cell(infoTable, 1, 1, latestRaw, text_color=color.white, bgcolor=color.purple)

